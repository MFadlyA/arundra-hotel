# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/.wrangler/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# certificates and keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# backups, dumps, and local databases
*.bak
*.backup
*.dump
*.sql.bak
*.sqlite
*.sqlite3
*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase schemas and sql migrations (kept private locally, never pushed to public git)
/supabase


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
