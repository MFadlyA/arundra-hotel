# Supabase Configuration for Arundra Signature Hotel
# Dapatkan URL dan ANON_KEY dari dashboard Supabase Anda:
# Project Settings -> API -> Project URL & Project API Keys (anon public)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - dapatkan dari Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
